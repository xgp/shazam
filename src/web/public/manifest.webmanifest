{
  "name": "shazam",
  "short_name": "shazam",
  "description": "Your GitHub pull requests and issues, with agent sessions one tap away.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#3f3f3f",
